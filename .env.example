PORT=3000

# Binds to localhost only by default (safest — nothing on your network can reach it).
# Only change this if you specifically want to open it up.
HOST=127.0.0.1

# Create a bot with @BotFather on Telegram, paste the token it gives you here.
TELEGRAM_BOT_TOKEN=

# Leave blank. The bot fills this in automatically the first time you DM it /start.
TELEGRAM_CHAT_ID=
